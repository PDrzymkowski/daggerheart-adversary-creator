<div
  x-data="adversaryBuilder()"
  data-adversary="<%= @adversary.to_builder_json %>"
  data-templates="<%= Adversary.templates_json %>"
  class="max-w-6xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-2 gap-8"
>
  <div><%= render "form", adversary: @adversary %></div>
  <div>
    <button type="button" @click="downloadPng()" class="mb-3 bg-stone-700 text-white px-4 py-2 rounded font-semibold">
      Download PNG
    </button>
    <%= render "card", adversary: @adversary %>
  </div>
</div>
